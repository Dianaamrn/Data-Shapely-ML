<mxfile><diagram name="Pipeline"><mxGraphModel adaptiveColors="auto" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="loop" value="Repeated for each seed 100 to 109" style="rounded=1;arcSize=6;dashed=1;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=3;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="15" y="140" width="790" height="150" as="geometry"/></mxCell><mxCell id="inner" value="for each of the 3 conditions" style="rounded=1;arcSize=8;dashed=1;html=1;fillColor=none;strokeColor=#bbbbbb;verticalAlign=top;align=right;spacingRight=8;spacingTop=1;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="212" y="160" width="585" height="108" as="geometry"/></mxCell><mxCell id="A" value="&lt;b&gt;Raw data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Penguins CSV; Gaussian data&lt;br&gt;generated from each seed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="175" height="78" as="geometry"/></mxCell><mxCell id="P" value="&lt;b&gt;Pilot (seed 100)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;no test data;&lt;br&gt;sets minimum: 2,000 permutations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="225" y="30" width="175" height="78" as="geometry"/></mxCell><mxCell id="B" value="&lt;b&gt;Build 3 conditions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;split, scale on train,&lt;br&gt;flip 20% of train labels&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="182" width="175" height="78" as="geometry"/></mxCell><mxCell id="D" value="&lt;b&gt;Shapley values&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;random permutations,&lt;br&gt;stop by the paper&#39;s rule&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="225" y="182" width="175" height="78" as="geometry"/></mxCell><mxCell id="E" value="&lt;b&gt;Rank and remove&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;LOW, HIGH, RANDOM&lt;br&gt;at 10, 20, 30, 40%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="182" width="175" height="78" as="geometry"/></mxCell><mxCell id="F" value="&lt;b&gt;Retrain 3-NN, test&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;test accuracy; how well low&lt;br&gt;values find flipped labels&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="615" y="182" width="175" height="78" as="geometry"/></mxCell><mxCell id="G" value="&lt;b&gt;Combine 10 seeds&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;LOW minus RANDOM,&lt;br&gt;bootstrap intervals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="615" y="325" width="175" height="78" as="geometry"/></mxCell><mxCell id="Hh" value="&lt;b&gt;Tables and figures&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;results notebook&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="325" width="175" height="78" as="geometry"/></mxCell><mxCell id="I" value="&lt;b&gt;Checks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;unit tests; regenerate orders,&lt;br&gt;recompute removal outcomes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="225" y="325" width="175" height="78" as="geometry"/></mxCell><mxCell id="L" value="Blue: training and validation data only.   Orange: test data, used only after the values are fixed." style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="15" y="415" width="790" height="22" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="A" target="P"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="A" target="B"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="P" target="D"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="B" target="D"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="D" target="E"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="E" target="F"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="F" target="G"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="G" target="Hh"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="Hh" target="I"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>